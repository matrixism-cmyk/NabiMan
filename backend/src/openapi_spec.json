{
  "openapi": "3.0.3",
  "info": {
    "title": "NabiMan Server Management API",
    "version": "1.0.0",
    "description": "REST API for NabiMan server management dashboard"
  },
  "servers": [{ "url": "/api" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "Auth", "description": "Authentication & authorization" },
    { "name": "Users", "description": "User management" },
    { "name": "API Keys", "description": "API key management" },
    { "name": "Monitoring", "description": "Server metrics & monitoring" },
    { "name": "Management", "description": "Service, container, package management" },
    { "name": "Configuration", "description": "Config file editing with versioning" },
    { "name": "Security", "description": "Firewall, SSL, IP blocking" },
    { "name": "Vhost", "description": "Apache/Nginx virtual host management" },
    { "name": "Database", "description": "MySQL/PostgreSQL management" },
    { "name": "Backup", "description": "Backup & restore with encryption" },
    { "name": "System", "description": "Logs, cron, files, terminal" },
    { "name": "Remote", "description": "Remote server management" },
    { "name": "Notifications", "description": "Notification channels & templates" },
    { "name": "Alerts", "description": "Alert rules (CPU/memory/disk/service/port/HTTP)" },
    { "name": "Audit", "description": "Audit logging with external forwarding" },
    { "name": "License", "description": "License management" }
  ],
  "paths": {
    "/auth/login": { "post": { "summary": "Login", "tags": ["Auth"], "responses": { "200": { "description": "JWT token pair" } } } },
    "/auth/logout": { "post": { "summary": "Logout", "tags": ["Auth"], "responses": { "200": { "description": "OK" } } } },
    "/auth/refresh": { "post": { "summary": "Refresh Token", "tags": ["Auth"], "responses": { "200": { "description": "New access token" } } } },
    "/auth/change-password": { "post": { "summary": "Change Password", "tags": ["Auth"], "responses": { "200": { "description": "OK" } } } },
    "/auth/2fa/verify": { "post": { "summary": "Verify 2FA", "tags": ["Auth"], "responses": { "200": { "description": "Token after TOTP" } } } },
    "/auth/oauth/config": { "get": { "summary": "Get OAuth Config", "tags": ["Auth"], "responses": { "200": { "description": "OAuth config" } } }, "post": { "summary": "Save OAuth Config", "tags": ["Auth"], "responses": { "200": { "description": "OK" } } } },
    "/auth/oauth/authorize": { "get": { "summary": "OAuth Authorize URL", "tags": ["Auth"], "responses": { "200": { "description": "Redirect URL" } } } },
    "/auth/oauth/callback": { "get": { "summary": "OAuth Callback", "tags": ["Auth"], "responses": { "200": { "description": "JWT after code exchange" } } } },
    "/auth/ldap/config": { "get": { "summary": "Get LDAP Config", "tags": ["Auth"], "responses": { "200": { "description": "LDAP config" } } }, "post": { "summary": "Save LDAP Config", "tags": ["Auth"], "responses": { "200": { "description": "OK" } } } },
    "/auth/ldap/test": { "post": { "summary": "Test LDAP Connection", "tags": ["Auth"], "responses": { "200": { "description": "Test result" } } } },
    "/auth/ldap/login": { "post": { "summary": "LDAP Login", "tags": ["Auth"], "responses": { "200": { "description": "JWT token" } } } },
    "/auth/sessions": { "get": { "summary": "List Sessions", "tags": ["Auth"], "responses": { "200": { "description": "Session list" } } } },
    "/users": { "get": { "summary": "List Users", "tags": ["Users"], "responses": { "200": { "description": "User list" } } }, "post": { "summary": "Create User", "tags": ["Users"], "responses": { "200": { "description": "OK" } } } },
    "/users/me": { "get": { "summary": "Current User", "tags": ["Users"], "responses": { "200": { "description": "User info" } } } },
    "/apikeys": { "get": { "summary": "List API Keys", "tags": ["API Keys"], "responses": { "200": { "description": "Key list" } } }, "post": { "summary": "Create API Key", "tags": ["API Keys"], "responses": { "200": { "description": "New key" } } } },
    "/server/status": { "get": { "summary": "Server Status", "tags": ["Monitoring"], "responses": { "200": { "description": "CPU/memory/disk/uptime" } } } },
    "/server/history": { "get": { "summary": "Metric History", "tags": ["Monitoring"], "parameters": [{ "name": "hours", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "Historical data points" } } } },
    "/disks/status": { "get": { "summary": "Disk Status", "tags": ["Monitoring"], "responses": { "200": { "description": "Partitions and I/O" } } } },
    "/network": { "get": { "summary": "Network Status", "tags": ["Monitoring"], "responses": { "200": { "description": "Interfaces" } } } },
    "/traffic": { "get": { "summary": "Traffic", "tags": ["Monitoring"], "responses": { "200": { "description": "Per-interface traffic" } } } },
    "/processes": { "get": { "summary": "Processes", "tags": ["Monitoring"], "responses": { "200": { "description": "Process list" } } } },
    "/containers": { "get": { "summary": "List Containers", "tags": ["Management"], "responses": { "200": { "description": "Docker containers" } } } },
    "/services": { "get": { "summary": "List Services", "tags": ["Management"], "responses": { "200": { "description": "systemd services" } } } },
    "/packages": { "get": { "summary": "List Packages", "tags": ["Management"], "responses": { "200": { "description": "Installed packages" } } } },
    "/updates/check": { "get": { "summary": "Check Updates", "tags": ["Management"], "responses": { "200": { "description": "Available updates" } } } },
    "/config/services": { "get": { "summary": "Config Services", "tags": ["Configuration"], "responses": { "200": { "description": "Configurable services" } } } },
    "/config/{id}": { "get": { "summary": "Read Config", "tags": ["Configuration"], "responses": { "200": { "description": "Config content" } } }, "post": { "summary": "Update Config", "tags": ["Configuration"], "responses": { "200": { "description": "OK" } } } },
    "/config/{id}/versions": { "get": { "summary": "Config Versions", "tags": ["Configuration"], "responses": { "200": { "description": "Version history" } } } },
    "/config/{id}/diff": { "get": { "summary": "Config Diff", "tags": ["Configuration"], "responses": { "200": { "description": "Diff result" } } } },
    "/config/{id}/rollback": { "post": { "summary": "Config Rollback", "tags": ["Configuration"], "responses": { "200": { "description": "OK" } } } },
    "/firewall": { "get": { "summary": "Firewall Status", "tags": ["Security"], "responses": { "200": { "description": "Rules" } } } },
    "/ssl/certificates": { "get": { "summary": "SSL Certificates", "tags": ["Security"], "responses": { "200": { "description": "Certificate list" } } } },
    "/ip-block/status": { "get": { "summary": "IP Block Status", "tags": ["Security"], "responses": { "200": { "description": "Blocking backend status" } } } },
    "/vhost": { "get": { "summary": "List Vhosts", "description": "Lists Apache and Nginx virtual hosts", "tags": ["Vhost"], "responses": { "200": { "description": "Vhost list" } } }, "post": { "summary": "Create Vhost", "description": "Create Apache or Nginx vhost", "tags": ["Vhost"], "responses": { "200": { "description": "OK" } } } },
    "/database/status": { "get": { "summary": "Database Status", "tags": ["Database"], "responses": { "200": { "description": "DB info" } } } },
    "/backup": { "get": { "summary": "List Backups", "tags": ["Backup"], "responses": { "200": { "description": "Backup list" } } } },
    "/backup/create-encrypted": { "post": { "summary": "Encrypted Backup", "description": "AES-256-CBC encrypted tar.gz", "tags": ["Backup"], "responses": { "200": { "description": "Filename" } } } },
    "/backup/restore-encrypted": { "post": { "summary": "Restore Encrypted", "tags": ["Backup"], "responses": { "200": { "description": "OK" } } } },
    "/logs": { "get": { "summary": "System Logs", "tags": ["System"], "responses": { "200": { "description": "Log entries" } } } },
    "/terminal": { "get": { "summary": "WebSocket Terminal", "description": "Persistent PTY sessions via WebSocket", "tags": ["System"], "responses": { "101": { "description": "WebSocket upgrade" } } } },
    "/terminal/sessions": { "get": { "summary": "Terminal Sessions", "tags": ["System"], "responses": { "200": { "description": "Active PTY sessions" } } } },
    "/remote-servers": { "get": { "summary": "List Remote Servers", "tags": ["Remote"], "responses": { "200": { "description": "Server list" } } } },
    "/remote-servers/check-all": { "post": { "summary": "Check All Servers", "tags": ["Remote"], "responses": { "200": { "description": "Status results" } } } },
    "/notifications/channels": { "get": { "summary": "List Channels", "tags": ["Notifications"], "responses": { "200": { "description": "Channel list" } } } },
    "/notifications/templates": { "get": { "summary": "List Templates", "description": "Custom alert message templates with {{variable}} substitution", "tags": ["Notifications"], "responses": { "200": { "description": "Template list" } } } },
    "/notifications/history": { "get": { "summary": "Notification History", "tags": ["Notifications"], "responses": { "200": { "description": "Delivery history" } } } },
    "/alerts/rules": { "get": { "summary": "List Alert Rules", "description": "Supports: cpu, memory, disk, service_down, port_check, http_check", "tags": ["Alerts"], "responses": { "200": { "description": "Rule list" } } } },
    "/audit": { "get": { "summary": "Audit Log", "tags": ["Audit"], "responses": { "200": { "description": "Audit entries" } } } },
    "/audit/verify": { "get": { "summary": "Verify Audit Integrity", "description": "SHA-256 hash chain verification", "tags": ["Audit"], "responses": { "200": { "description": "Verification result" } } } },
    "/audit/forwarding": { "get": { "summary": "Forwarding Config", "description": "Syslog UDP/TCP and HTTP forwarding", "tags": ["Audit"], "responses": { "200": { "description": "Config list" } } } },
    "/license/status": { "get": { "summary": "License Status", "tags": ["License"], "responses": { "200": { "description": "Tier/features/expiry" } } } },
    "/license/activate": { "post": { "summary": "Activate License", "tags": ["License"], "responses": { "200": { "description": "OK" } } } },
    "/openapi.json": { "get": { "summary": "OpenAPI Spec", "tags": ["System"], "responses": { "200": { "description": "This document" } } } }
  }
}

[Unit]
Description=NabiMan typed service-control helper
After=dbus.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/nabiman-privileged-helper
RuntimeDirectory=nabiman-helper
RuntimeDirectoryMode=0755
StateDirectory=nabiman-helper
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nabiman-helper /run/nabiman-helper /etc/systemd/system
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
LimitNOFILE=128
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
